{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "聊天窗口：发送/停止/重新生成消息、切换气泡与面板、打开设置",
  "windows": ["chat"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-chat-init",
    "allow-chat-send",
    "allow-chat-regenerate",
    "allow-chat-stop",
    "allow-chat-set-mode",
    "allow-chat-fit",
    "allow-chat-hide",
    "allow-open-settings",
    "allow-ability-open",
    "allow-ability-read",
    "allow-proactive-feedback",
    "allow-reminder-save",
    "allow-event-choose",
    "allow-game-say",
    "allow-game-finish",
    "allow-game-stats",
    "allow-fortune-today",
    "allow-fortune-draw",
    "allow-llm-game-start",
    "allow-llm-game-turn",
    "allow-llm-game-give-up",
    "allow-task-defaults",
    "allow-task-start",
    "allow-task-approve",
    "allow-task-decline",
    "allow-task-cancel",
    "allow-chat-task-report"
  ]
}
